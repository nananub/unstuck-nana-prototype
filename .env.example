# Copy this file to .env and fill in the values. Never commit .env.
# On Render, add the same names under your service's Environment settings instead.

# --- AI (required for the AI features) ---
# Free key: https://aistudio.google.com/app/apikey  (new keys start with AQ.)
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.8-flash
RATE_LIMIT_PER_MINUTE=20

# --- Admin page at /admin (required to open it) ---
ADMIN_PASSWORD=change-me

# --- Keep stats permanently in Supabase (optional, recommended on Render) ---
# Without these, stats live in memory and reset when the server restarts or sleeps.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_TABLE=unstuck_events

# Only needed if the website is hosted somewhere else (e.g. GitHub Pages) and calls this server:
# ALLOWED_ORIGINS=https://aellanguyen.github.io
